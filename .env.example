# Central PostgreSQL connection used by Vercel, Sites, and local migrations.
DATABASE_URL=

# Public browser key. This value is embedded in the client bundle by design.
NEXT_PUBLIC_KAKAO_JS_KEY=

# Server-only Kakao OAuth credentials. Never prefix these with NEXT_PUBLIC_.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# KakaoTalk Channel public ID, for example _abc123.
KAKAO_CHANNEL_ID=

# 카카오톡 채널 웹훅 검증용 대표 어드민 키 (서버 전용)
KAKAO_ADMIN_KEY=
